NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://fittrack_app:change_me@localhost:5432/fittrack
PGSSL=false
COOKIE_SECRET=replace_with_a_long_random_secret_at_least_32_chars
CLIENT_ORIGIN=http://localhost:5173
FITTRACK_ADMIN_EMAIL=admin@fittrack.local
FITTRACK_ADMIN_PASSWORD=replace_with_a_strong_password

# Optional: one branch ID for restricted staff; all for organization administrators.
# Omit on updates to preserve an existing account scope.
FITTRACK_ADMIN_GYM_ID=all
